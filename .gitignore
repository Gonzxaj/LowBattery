/installer/msix.env

# Logs and screen recordings from real PCs (Windows user name, device details)
*.log
*.mp4

/docs
# Flatpak / Snap build outputs
/build-flatpak
/.flatpak-builder
/installer/flatpak/cargo-sources.json
/parts
/stage
/prime
*.snap
