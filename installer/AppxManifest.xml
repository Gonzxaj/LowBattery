<?xml version="1.0" encoding="utf-8"?>
<!-- Template: docker/pack-msix.sh fills @NAME@ @PUBLISHER@ @PUBLISHER_DISPLAY@ @VERSION@.
     For the Store, NAME and PUBLISHER must be the values Partner Center shows under
     Product management > Product identity (Package/Identity/Name and Publisher). -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity Name="@NAME@" Publisher="@PUBLISHER@" Version="@VERSION@" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>LowBattery</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <!-- First = default. The app UI ships in English (default) and Spanish. -->
    <Resource Language="en-us" />
    <Resource Language="es-ar" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="lowbattery.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="LowBattery"
        Description="Battery levels for wireless mice, keyboards, headsets and controllers."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- "Iniciar con Windows": toggled at runtime via the WinRT StartupTask API (os.rs). -->
        <desktop:Extension Category="windows.startupTask" Executable="lowbattery.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="LowBatteryStartup" Enabled="false" DisplayName="LowBattery" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Win32 desktop app: needed for HID (hidapi), SetupAPI and the tray icon. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
